# Copy to .env and edit before first boot.
# Do not commit .env.

ENV=production

# Public HTTPS origin used in pairing checks and Android setup docs.
OWNERLINK_BASE_URL=https://ownerlink.example.com

# First-boot only. After the owner row exists, remove OWNERLINK_ADMIN_PASSWORD.
# Username: at least 3 characters. Password: at least 12 characters.
# There is no default admin/admin account.
OWNERLINK_ADMIN_USERNAME=owner
OWNERLINK_ADMIN_PASSWORD=replace-with-a-long-random-password

# At least 32 random characters. Example: python -c "import secrets; print(secrets.token_hex(32))"
OWNERLINK_SECRET_KEY=replace-with-64-hex-or-similar-secret

# Production on Render: device/pairing/session metadata lives durably in Upstash.
STORAGE_BACKEND=redis
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Optional WebRTC relay fallback. TURN_SHARED_SECRET stays server-side and
# must match Coturn's private use-auth-secret configuration.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_REALM=privatchat
TURN_CREDENTIAL_TTL=3600

# Local-only alternative (do not use on Render):
# STORAGE_BACKEND=sqlite
# DATABASE_URL=sqlite:///./ownerlink.db
