# PrivatChat Coturn example. Copy outside Git, replace the placeholders, and
# protect the resulting file (0600). Never commit the real shared secret.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=<TURN_SHARED_SECRET>
realm=<TURN_REALM>
server-name=<TURN_HOSTNAME>
cert=/etc/letsencrypt/live/<TURN_HOSTNAME>/fullchain.pem
pkey=/etc/letsencrypt/live/<TURN_HOSTNAME>/privkey.pem
no-cli
no-multicast-peers
no-loopback-peers
stale-nonce=600
min-port=49160
max-port=49200
total-quota=200
user-quota=12
log-file=stdout
simple-log
