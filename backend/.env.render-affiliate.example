# Copy these names into the standalone Affiliate Render service.
# Never put real credentials in this file or commit them to Git.
ENV=production
STORAGE_BACKEND=redis
OWNERLINK_BASE_URL=https://ownerlink-affiliate.onrender.com
OWNERLINK_SECRET_KEY=GENERATE_A_NEW_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
OWNERLINK_ADMIN_USERNAME=CHOOSE_YOUR_ADMIN_USERNAME
OWNERLINK_ADMIN_PASSWORD=CHOOSE_A_NEW_STRONG_PASSWORD_OF_AT_LEAST_12_CHARACTERS
UPSTASH_REDIS_REST_URL=PASTE_THE_NEW_AFFILIATE_UPSTASH_REST_URL
UPSTASH_REDIS_REST_TOKEN=PASTE_THE_NEW_AFFILIATE_UPSTASH_REST_TOKEN
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_REALM=affiliate
TURN_CREDENTIAL_TTL=3600
